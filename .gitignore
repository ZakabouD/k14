node_modules
# Keep environment variables out of version control
.env
.env*
!.env.example
!.env.worker.example
!.env.docker.example
!.env.backup.example

/generated/prisma

# Build and temporary files
dist/
scratch/
.DS_Store
**/.DS_Store
*.log
dev/

# Database backups - exclude all dump, partial, and checksum files
backups/**/*.dump
backups/**/*.dump.partial
backups/**/*.sha256
backups/**/*.sql
backups/**/*.tar
backups/**/*.gz
!backups/**/.gitkeep
