# ==============================================================================
# Commercial Attendance Stack - Off-Site Cloudflare R2 Backup Configuration
# Copy this file to .env.backup and adjust values before enabling off-site backups:
#   cp .env.backup.example .env.backup
# ==============================================================================

# Enable or disable remote off-site backup upload (true/false)
BACKUP_REMOTE_ENABLED=false

# Client Identification (Used as root logical prefix in the R2 bucket)
# Allowed format: Alphanumeric, hyphens, and underscores only (e.g. client-acme-casablanca)
# STRICTLY NO path traversal characters (no '..', '/', '\')
BACKUP_CLIENT_ID=client-default

# Cloudflare R2 Account & Bucket Configuration
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET=your_r2_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Custom R2 S3-Compatible Endpoint URL
# Standard formula: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# Retention Policies (in days)
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_REMOTE_RETENTION_DAYS=30
