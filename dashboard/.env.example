# Database connection URL
DATABASE_URL="postgresql://zk_user:password@localhost:5432/zk_attendance?schema=public"

# Session JWT encryption secret (Must be changed in production)
JWT_SECRET="generate_a_secure_random_64_character_secret_key"
NODE_ENV="production"
PORT=3000

# Optional initial administrator bootstrap credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisPassword123!"

# Default Company Settings (Can also be configured via Web UI)
COMPANY_NAME="Mon Entreprise"
TIMEZONE="Africa/Casablanca"
DEFAULT_CURRENCY="DH"
