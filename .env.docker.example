# ==============================================================================
# Commercial Attendance Stack - Docker Environment Configuration Template
# Copy this file to .env.docker and adjust values before starting Docker Compose:
#   cp .env.docker.example .env.docker
# ==============================================================================

# Domain & Public Reverse Proxy Configuration
# Set to your production FQDN (e.g. pointage.client.ma)
# For local testing, use: localhost
APP_DOMAIN=pointage.example.com

# Optional TLS Mode (Leave empty for automatic production Let's Encrypt / ACME)
# For local self-signed TLS testing on custom hostnames: TLS_CONFIG="tls internal"
TLS_CONFIG=

# PostgreSQL Database Configuration
POSTGRES_DB=attendance
POSTGRES_USER=attendance_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

# Security & Session Encryption
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_32_CHARACTERS

# Initial Administrator Bootstrap (Created on first startup only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Company & Regional Settings
COMPANY_NAME=Mon Entreprise
DEFAULT_CURRENCY=DH
TIMEZONE=Africa/Casablanca
